# n8n Oracle Cloud Deployment Configuration
# Copy this file to .env and update with your values

# ===================================
# Domain Configuration
# ===================================
# Your domain name (e.g., n8n.example.com or example.com)
DOMAIN_NAME=n8n.yourdomain.com

# Subdomain (if using subdomain, otherwise leave empty)
SUBDOMAIN=n8n

# ===================================
# Timezone
# ===================================
# Find your timezone: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Examples: America/New_York, Europe/London, Asia/Tokyo, America/Los_Angeles
GENERIC_TIMEZONE=America/New_York

# ===================================
# n8n Authentication
# ===================================
# IMPORTANT: Change these to secure values!
# These are your n8n login credentials
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ChangeMeToASecurePassword123!

# ===================================
# PostgreSQL Database
# ===================================
# IMPORTANT: Change this to a secure password!
# This is the database password
POSTGRES_PASSWORD=AnotherSecurePassword456!

# ===================================
# Email Configuration (Optional)
# ===================================
# Only needed if you want n8n to send email notifications
# Leave empty if you don't need email

# Email mode (smtp or leave empty to disable)
N8N_EMAIL_MODE=smtp

# SMTP Settings - Gmail Example
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password-here
N8N_SMTP_SENDER=your-email@gmail.com
N8N_SMTP_SSL=true

# Other SMTP Providers:
#
# Outlook/Hotmail:
# N8N_SMTP_HOST=smtp-mail.outlook.com
# N8N_SMTP_PORT=587
#
# Yahoo:
# N8N_SMTP_HOST=smtp.mail.yahoo.com
# N8N_SMTP_PORT=587
#
# SendGrid:
# N8N_SMTP_HOST=smtp.sendgrid.net
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=apikey
# N8N_SMTP_PASS=your-sendgrid-api-key
#
# Mailgun:
# N8N_SMTP_HOST=smtp.mailgun.org
# N8N_SMTP_PORT=587

# ===================================
# Advanced Configuration (Optional)
# ===================================
# Usually you don't need to change these

# n8n version (leave as 'latest' or specify version like '1.0.0')
N8N_VERSION=latest

# Execution mode (main or queue)
EXECUTIONS_PROCESS=main

# Enable metrics endpoint (true/false)
N8N_METRICS=false

# Log level (error, warn, info, debug)
N8N_LOG_LEVEL=info
